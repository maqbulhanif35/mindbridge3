# ════════════════════════════════════════════════════════════
# STEP 1 — Install dependencies
# ════════════════════════════════════════════════════════════
import subprocess, sys
subprocess.run(
    [sys.executable, '-m', 'pip', 'install', '-q',
     'tensorflow>=2.15', 'datasets', 'scikit-learn'],
    check=False
)

